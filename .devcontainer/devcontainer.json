{
  "name": "FintechSaaS",

  // ── Universal image already has Node 20 + Java 21 + Maven + Python + Docker CLI ──
  // No `features` block on purpose: the recent GitHub bump to Debian Trixie broke
  // both docker-in-docker (no moby package) and docker-outside-of-docker
  // (apt-get can't find docker-ce-cli). The universal image already ships everything
  // we need, so we just don't add features.
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",

  // ── Editor setup ────────────────────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql",
        "eamodio.gitlens"
      ]
    }
  },

  // ── Port forwarding ─────────────────────────────────────────────────
  "forwardPorts": [3000, 4000, 8080, 8081, 3307, 9000],
  "portsAttributes": {
    "3000": { "label": "Frontend (Next.js)", "onAutoForward": "notify" },
    "4000": { "label": "BFF (Express)", "onAutoForward": "silent" },
    "8080": { "label": "Nginx Gateway",  "onAutoForward": "openBrowser" },
    "8081": { "label": "Backend (Spring Boot)", "onAutoForward": "silent" },
    "3307": { "label": "MySQL", "onAutoForward": "silent" },
    "9000": { "label": "MinIO", "onAutoForward": "silent" }
  },

  // ── First-run setup — tolerant of partial failures ──────────────────
  // `|| true` keeps the container alive even if one step fails; the user
  // can then fix and re-run manually from the terminal.
  "postCreateCommand": "bash .devcontainer/post-create.sh || true",

  // ── Codespaces Secrets (set at https://github.com/settings/codespaces)
  "secrets": {
    "GROQ_API_KEY":           { "description": "Groq API key — https://console.groq.com/keys" },
    "DEMO_EMPLOYEE_PASSWORD": { "description": "Auth0 password for Anna Müller (EMPLOYEE)" },
    "DEMO_MANAGER_PASSWORD":  { "description": "Auth0 password for Thomas Weber (MANAGER)" },
    "DEMO_FINANCE_PASSWORD":  { "description": "Auth0 password for Sarah Chen (FINANCE)" },
    "DEMO_ADMIN_PASSWORD":    { "description": "Auth0 password for David Kim (ADMIN)" }
  },

  // ── Machine size: keep modest so any free-tier account can spin it up.
  // The stack runs on 2-core/8GB — Java warmup is a bit slower, not blocking.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  }
}
