# ════════════════════════════════════════════════════════════════════════
#  Frontend — Next.js 15 (App Router)
# ════════════════════════════════════════════════════════════════════════
#
#  Copy:  cp .env.example .env.local
#  NEVER commit .env.local — already in .gitignore.
#
# ════════════════════════════════════════════════════════════════════════

# ─── BFF endpoint ───────────────────────────────────────────────────────
#  Used by RTK Query and other client-side API calls.
#
#  Defaults:
#    - Docker compose: /api (proxied by Nginx gateway)
#    - Local dev:      http://localhost:4000
#
NEXT_PUBLIC_BFF_URL=http://localhost:4000

# ─── Internal BFF URL (server-side only, build-time) ────────────────────
#  Used inside Server Components / Route Handlers to reach the BFF without
#  going through the public proxy. Relevant only for Docker builds.
#
# BFF_INTERNAL_URL=http://nextjs-bff:4000

# ─── Environment ────────────────────────────────────────────────────────
NODE_ENV=development
