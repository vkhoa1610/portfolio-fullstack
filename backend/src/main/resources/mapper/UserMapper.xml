<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.my_java_app.mapper.UserMapper">

    <select id="findAll" resultType="com.example.my_java_app.entity.UserEntity">
        SELECT id, name, email FROM users
    </select>

    <select id="findById" parameterType="string" resultType="com.example.my_java_app.entity.UserEntity">
        SELECT id, name, email FROM users WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.example.my_java_app.entity.UserEntity">
        INSERT INTO users(id, name, email) VALUES (UUID(), #{name}, #{email})
    </insert>

</mapper>
