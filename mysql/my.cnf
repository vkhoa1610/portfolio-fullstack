# ============================================================
# UTF-8 charset fix — see docs/db-routing.md for the incident this
# addresses.
#
# The official mysql:8.0 image already defaults character_set_server
# to utf8mb4, but the `mysql` CLI CLIENT used internally by Docker's
# docker-entrypoint-initdb.d mechanism (to import db_fix.sql on first
# container init) defaults ITS OWN client-side charset to latin1 unless
# told otherwise. That mismatch double-encodes any multi-byte UTF-8
# character already in db_fix.sql (e.g. "Müller" -> "MÃ¼ller") the
# moment it's INSERTed — corrupting the stored bytes permanently, not
# just a display issue.
#
# This file is mounted into /etc/mysql/conf.d/ (auto-included by the
# image's /etc/mysql/my.cnf) so every mysql client connection — the
# init-script import included — defaults to utf8mb4, with no reliance
# on remembering to pass --default-character-set by hand.
# ============================================================

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
