{
  "name": "portfolio-fullstack-root",
  "private": true,
  "description": "Root scripts for managing the monorepo. No dependencies needed here.",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:bff": "cd bff && npm run dev",
    "dev:backend": "cd backend && ./mvnw spring-boot:run",
    "build:frontend": "cd frontend && npm run build",
    "build:bff": "cd bff && npm run build",
    "docker:up": "docker-compose up --build",
    "docker:up:ai": "docker-compose down --remove-orphans && docker-compose --profile ai up --build",
    "docker:down": "docker-compose --profile ai down --remove-orphans",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --rmi all",
    "docker:ai:on": "docker-compose --profile ai up -d ollama ollama-init",
    "docker:ai:off": "docker-compose --profile ai stop ollama ollama-init",
    "install:all": "cd frontend && npm install && cd ../bff && npm install",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "bash -c \"cd frontend && npm run lint\""
    ],
    "bff/**/*.{ts,js}": [
      "bash -c \"cd bff && npm run build\""
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
