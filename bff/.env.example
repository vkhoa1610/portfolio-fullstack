# ════════════════════════════════════════════════════════════════════════
#  BFF — Express + TypeScript
# ════════════════════════════════════════════════════════════════════════
#
#  Use this when running `npm run dev` inside /bff directly (hot reload).
#  When running via docker-compose, the root .env is used instead.
#
#  Copy:  cp .env.example .env
#
# ════════════════════════════════════════════════════════════════════════

PORT=4000

# ─── Backend reachability ───────────────────────────────────────────────
#  Inside Docker network: http://spring-backend:8080
#  Local dev with `mvn spring-boot:run`: http://localhost:8080
JAVA_API_URL=http://localhost:8080

# ─── Auth0 / Cognito ────────────────────────────────────────────────────
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# ─── Demo accounts (one-click login) ────────────────────────────────────
DEMO_EMPLOYEE_EMAIL=employee@portfolio.app
DEMO_EMPLOYEE_PASSWORD=
DEMO_MANAGER_EMAIL=manager@portfolio.app
DEMO_MANAGER_PASSWORD=
DEMO_FINANCE_EMAIL=finance@portfolio.app
DEMO_FINANCE_PASSWORD=
DEMO_ADMIN_EMAIL=admin@portfolio.app
DEMO_ADMIN_PASSWORD=
# Fresh employee — no user_profiles row, triggers onboarding flow.
DEMO_NEW_EMPLOYEE_EMAIL=new.employee@demo.com
DEMO_NEW_EMPLOYEE_PASSWORD=

# ─── Groq AI ────────────────────────────────────────────────────────────
#  Required for AI policy insight (ins-001) and manager AI report.
#  Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
