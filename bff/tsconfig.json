{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "strict": true,
    "rootDir": "src",
     "baseUrl": "src",
    "paths": {
      "@common/*": ["common/*"],
      "@product/*": ["product/*"]
    }
  },
  "include": ["src"]
}
